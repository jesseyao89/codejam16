# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Dataset (AGENTS.md §8: configurable data location) ---
# Relative paths are resolved from backend/.
DATA_DIR=../datasets/brim_ap_dataset

# Optional: override the inbox attachment directory.
# Defaults to DATA_DIR/incoming_invoices.
# INBOX_ATTACHMENT_DIR=

# --- Demo auth (synthetic accounts; see docs/DEMO_USERS.md) ---
DEMO_PASSWORD=demo1234

# --- AI provider (used by automation/extraction.py and coding.py) ---
# The openai client reads OPENAI_API_KEY from the environment by default.
OPENAI_API_KEY=

# Optional: coding model (falls back to OPENAI_MODEL, then gpt-4.1-mini).
# CODING_MODEL=gpt-4.1-mini
# Optional: coding fallback timeout in seconds (default 30).
# CODING_TIMEOUT_SECONDS=30
